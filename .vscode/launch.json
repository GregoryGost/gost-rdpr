{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "main.py debug",
      "type": "debugpy",
      "request": "launch",
      "program": "main.py",
      "console": "integratedTerminal",
      "consoleName": "DEBUG MAIN"
    },
    {
      "name": "current file debug",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "consoleName": "DEBUG ${file}"
    }
  ]
}
